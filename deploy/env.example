# /etc/sftp-backup-ui/env - systemd EnvironmentFile
# İlk deploy'da sunucuya kopyalanır; sonraki deploy'larda ÜZERİNE YAZILMAZ,
# değerleri elle düzenleyin.

ADMIN_USER=admin
ADMIN_PASSWORD=changeme
LISTEN_ADDR=:8080

# Varsayılanlar genelde yeterlidir, gerekirse açın:
# Kaynak sunucuların SFTP/rsync ile bağlandığı adres (boşsa HTTP Host kullanılır)
# BACKUP_SFTP_HOST=10.1.3.250
# BACKUP_SFTP_PORT=22
# Kaynak sunucuya root SSH (hesap takibini otomatik kurar; boşsa sadece upload/'a kopyalar)
# SOURCE_SSH_PORT=1064
# SOURCE_SSH_USER=root
# ACCOUNT_COUNT_SCRIPT=/opt/sftp-backup-ui/contrib/account-count-check-setup.sh
# BACKUP_MOUNT_REGEX=^/backup[0-9]+$
# SSHD_CONFIG_DIR=/etc/ssh/sshd_config.d
# SSHD_SERVICE_NAME=sshd
# PROJECT_ID_BASE=100
